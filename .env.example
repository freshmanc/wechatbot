# 数据库
DATABASE_URL=postgresql://wxbot:wxbot_secret@localhost:5432/wxbot

# Redis
REDIS_URL=redis://localhost:6379/0

# 企业微信自建应用
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=
WECOM_BOT_USER_ID=
WECOM_BOT_NAME=

# 应用
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# RAG / LLM（本地 LM Studio：Chat=Qwen3-8B，Embedding=nomic，启动 Server 后填下面）
VECTOR_STORE=pgvector
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
LLM_MODEL=Qwen3-8B
LLM_TIMEOUT_SEC=15
OPENAI_API_KEY=sk-dummy
OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# 限额（每日）
LIMIT_USER_DAILY=50
LIMIT_GROUP_DAILY=200
LIMIT_GLOBAL_DAILY=10000

# 免责声明
DISCLAIMER_ENABLED=true
DISCLAIMER_TEXT=以上内容仅供参考，不构成投资或法律建议。

# Chroma 持久化（留空则内存）
CHROMA_PERSIST_DIR=
