# 数据库
DATABASE_URL=postgresql://wxbot:wxbot_secret@localhost:5432/wxbot

# Redis
REDIS_URL=redis://localhost:6379/0

# 企业微信自建应用
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=

# 应用
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# RAG
VECTOR_STORE=pgvector
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=15
OPENAI_API_KEY=

# 限额（每日）
LIMIT_USER_DAILY=50
LIMIT_GROUP_DAILY=200
LIMIT_GLOBAL_DAILY=10000

# 免责声明
DISCLAIMER_ENABLED=true
DISCLAIMER_TEXT=以上内容仅供参考，不构成投资或法律建议。
